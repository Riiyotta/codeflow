{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pagespec.schema.json",
  "title": "PageSpec (codeflow waitlist design-repo)",
  "description": "Machine contract for a page composed from this design-repo. Closed everywhere. `mode` (reference | generated) says whether the page is for the source brand or for any other brand; `tokens` names the page-level design tokens by catalog path (tokens/llm/token-catalog.json). Per-(section, variant) node shapes are fully independent oneOf branches (no shared base + additionalProperties trap). Semantic rules (token policy, generated-mode isolation, template cross-reference, compliance) live in semantic_validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageSpecVersion",
    "mode",
    "template",
    "route",
    "theme",
    "contentProvenance",
    "tokens",
    "meta",
    "fonts",
    "pageMotion",
    "nodes"
  ],
  "properties": {
    "pageSpecVersion": {
      "const": "1.2.0"
    },
    "mode": {
      "enum": [
        "reference",
        "generated"
      ],
      "description": "reference = a page for the source brand (every asset role available); generated = a page for any other brand (only generation-safe roles, no source brand, copy or hosts). Must agree with contentProvenance. See assets/asset-roles.json modes."
    },
    "template": {
      "enum": [
        "template.waitlist-landing"
      ]
    },
    "route": {
      "type": "string",
      "pattern": "^/[a-z0-9/-]*$"
    },
    "theme": {
      "enum": [
        "dark"
      ]
    },
    "contentProvenance": {
      "enum": [
        "evidence-reference",
        "generated"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "ogImage",
        "favicon"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "ogImage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "source"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "enum": [
                    "meta.og-image",
                    "meta.og-placeholder"
                  ]
                }
              ]
            },
            "source": {
              "$ref": "#/definitions/assetSource"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "favicon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "source"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "enum": [
                    "meta.favicon",
                    "meta.favicon-placeholder"
                  ]
                }
              ]
            },
            "source": {
              "$ref": "#/definitions/assetSource"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "analytics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "source"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "const": "endpoint.analytics"
                }
              ]
            },
            "source": {
              "$ref": "#/definitions/assetSource"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sans",
        "mono"
      ],
      "properties": {
        "sans": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "source"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "const": "font.commercial-sans"
                }
              ]
            },
            "source": {
              "$ref": "#/definitions/assetSource"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "mono": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole",
            "source"
          ],
          "properties": {
            "assetRole": {
              "allOf": [
                {
                  "$ref": "#/definitions/assetRole"
                },
                {
                  "const": "font.mono"
                }
              ]
            },
            "source": {
              "$ref": "#/definitions/assetSource"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    },
    "pageMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "page-fade-in",
              "smooth-scroll-wheel",
              "anchor-scroll"
            ]
          }
        },
        "reducedMotionFallback": {
          "const": "no-fade-native-scroll"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "Page-level design tokens, each a catalog path (tokens/llm/token-catalog.json). Closed set of slots: tokens/llm/token-policy.json pageSpecTokenSlots. Whether a path is a real, approved, theme-valid token for its slot is checked by schema/semantic_validate.py (TOKEN_* rules); a raw colour, length or font name is rejected there.",
      "required": [
        "surface",
        "text",
        "fontSans",
        "fontDisplay",
        "fontMono",
        "sectionPadding",
        "buttonRadius"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "border": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fontSans": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fontDisplay": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fontMono": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sectionPadding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "buttonRadius": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    }
  },
  "definitions": {
    "sectionId": {
      "enum": [
        "content.block-pairs",
        "cta.pitch-timeline",
        "cta.waitlist-form",
        "hero.course-intro",
        "layer.webgl-object",
        "list.numbered-topics",
        "shell.footer-wordmark",
        "shell.nav"
      ]
    },
    "assetRole": {
      "enum": [
        "brand.logo-mark",
        "brand.logo-placeholder",
        "endpoint.analytics",
        "endpoint.form-action",
        "font.commercial-sans",
        "font.mono",
        "icon.arrow",
        "icon.discord",
        "identity.author-link",
        "identity.link-placeholder",
        "meta.favicon",
        "meta.favicon-placeholder",
        "meta.og-image",
        "meta.og-placeholder",
        "webgl.colormap-placeholder",
        "webgl.cube-model",
        "webgl.matcap",
        "webgl.matcap-placeholder",
        "webgl.model-placeholder",
        "webgl.sticker-colormap"
      ]
    },
    "assetSource": {
      "enum": [
        "fallback-stack",
        "generated",
        "licensed-by-deployer",
        "placeholder"
      ]
    },
    "motionPattern": {
      "enum": [
        "alpha-fade",
        "anchor-scroll",
        "cta-hover",
        "link-hover-opacity",
        "page-fade-in",
        "scale-dot",
        "scale-line",
        "scramble-text",
        "smooth-scroll-wheel",
        "text-reveal-char-drop",
        "text-reveal-word",
        "webgl-click-bump",
        "webgl-cta-hover-darken",
        "webgl-drop-in",
        "webgl-idle-tumble",
        "webgl-pointer-inertia",
        "webgl-scroll-coupling",
        "webgl-solve"
      ]
    },
    "reducedMotionFallback": {
      "enum": [
        "final-state-instant",
        "no-fade-native-scroll",
        "static-single-frame"
      ]
    },
    "layer": {
      "enum": [
        "front",
        "behind-canvas",
        "behind-canvas-deep"
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "layer"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "$ref": "#/definitions/layer"
        }
      }
    },
    "displayHeading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines"
      ],
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/segment"
            },
            "minItems": 1,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 3
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "const": "#signup"
        }
      }
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "headingLines",
        "body"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "headingLines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "monoNote": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 5
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "section",
        "variant",
        "content",
        "motion"
      ],
      "properties": {
        "section": {
          "$ref": "#/definitions/sectionId"
        },
        "motion": {
          "type": "object",
          "required": [
            "reducedMotionFallback"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/definitions/node__shell_nav__default"
        },
        {
          "$ref": "#/definitions/node__hero_course_intro__default"
        },
        {
          "$ref": "#/definitions/node__list_numbered_topics__default"
        },
        {
          "$ref": "#/definitions/node__content_block_pairs__feature_pairs"
        },
        {
          "$ref": "#/definitions/node__cta_pitch_timeline__default"
        },
        {
          "$ref": "#/definitions/node__cta_waitlist_form__default"
        },
        {
          "$ref": "#/definitions/node__shell_footer_wordmark__default"
        },
        {
          "$ref": "#/definitions/node__layer_webgl_object__default"
        }
      ]
    },
    "node__shell_nav__default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "variant",
        "content",
        "motion"
      ],
      "properties": {
        "section": {
          "const": "shell.nav"
        },
        "variant": {
          "const": "default"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intro",
            "versionTag",
            "cta",
            "logo"
          ],
          "properties": {
            "intro": {
              "type": "string",
              "minLength": 1
            },
            "versionTag": {
              "type": "string",
              "minLength": 1
            },
            "cta": {
              "$ref": "#/definitions/cta"
            },
            "communityLink": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "icon",
                "hidden"
              ],
              "properties": {
                "icon": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "assetRole",
                    "source"
                  ],
                  "properties": {
                    "assetRole": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/assetRole"
                        },
                        {
                          "const": "icon.discord"
                        }
                      ]
                    },
                    "source": {
                      "$ref": "#/definitions/assetSource"
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  }
                },
                "hidden": {
                  "const": true
                }
              }
            },
            "logo": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetRole",
                "source"
              ],
              "properties": {
                "assetRole": {
                  "allOf": [
                    {
                      "$ref": "#/definitions/assetRole"
                    },
                    {
                      "enum": [
                        "brand.logo-mark",
                        "brand.logo-placeholder"
                      ]
                    }
                  ]
                },
                "source": {
                  "$ref": "#/definitions/assetSource"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patterns",
            "reducedMotionFallback"
          ],
          "properties": {
            "patterns": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "enum": [
                  "scramble-text",
                  "cta-hover"
                ]
              }
            },
            "reducedMotionFallback": {
              "const": "final-state-instant"
            }
          }
        }
      }
    },
    "node__hero_course_intro__default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "variant",
        "anchorId",
        "content",
        "motion"
      ],
      "properties": {
        "section": {
          "const": "hero.course-intro"
        },
        "variant": {
          "const": "default"
        },
        "anchorId": {
          "const": "intro"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "heading",
            "subheading",
            "cta",
            "priceNote"
          ],
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1
            },
            "heading": {
              "$ref": "#/definitions/displayHeading"
            },
            "subheading": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "regular",
                "bold"
              ],
              "properties": {
                "regular": {
                  "type": "string",
                  "minLength": 1
                },
                "bold": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "cta": {
              "$ref": "#/definitions/cta"
            },
            "priceNote": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line1",
                "line2"
              ],
              "properties": {
                "line1": {
                  "type": "string",
                  "minLength": 1
                },
                "line2": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patterns",
            "reducedMotionFallback"
          ],
          "properties": {
            "patterns": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "enum": [
                  "scramble-text",
                  "text-reveal-word",
                  "alpha-fade",
                  "cta-hover"
                ]
              }
            },
            "reducedMotionFallback": {
              "const": "final-state-instant"
            }
          }
        }
      }
    },
    "node__list_numbered_topics__default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "variant",
        "anchorId",
        "content",
        "motion"
      ],
      "properties": {
        "section": {
          "const": "list.numbered-topics"
        },
        "variant": {
          "const": "default"
        },
        "anchorId": {
          "const": "content"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "items",
            "summary"
          ],
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/segment"
              },
              "minItems": 2,
              "maxItems": 20
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patterns",
            "reducedMotionFallback"
          ],
          "properties": {
            "patterns": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "enum": [
                  "scramble-text",
                  "text-reveal-word",
                  "alpha-fade"
                ]
              }
            },
            "reducedMotionFallback": {
              "const": "final-state-instant"
            }
          }
        }
      }
    },
    "node__content_block_pairs__feature_pairs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "variant",
        "anchorId",
        "content",
        "motion"
      ],
      "properties": {
        "section": {
          "const": "content.block-pairs"
        },
        "variant": {
          "const": "feature-pairs"
        },
        "anchorId": {
          "const": "cta"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "left",
                  "right"
                ],
                "properties": {
                  "left": {
                    "$ref": "#/definitions/textBlock"
                  },
                  "right": {
                    "$ref": "#/definitions/textBlock"
                  }
                }
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patterns",
            "reducedMotionFallback"
          ],
          "properties": {
            "patterns": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "enum": [
                  "scramble-text",
                  "text-reveal-word",
                  "alpha-fade"
                ]
              }
            },
            "reducedMotionFallback": {
              "const": "final-state-instant"
            }
          }
        }
      }
    },
    "node__cta_pitch_timeline__default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "variant",
        "anchorId",
        "content",
        "motion"
      ],
      "properties": {
        "section": {
          "const": "cta.pitch-timeline"
        },
        "variant": {
          "const": "default"
        },
        "anchorId": {
          "const": "cta"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kicker",
            "heading",
            "cta",
            "priceNote",
            "row",
            "timeline"
          ],
          "properties": {
            "kicker": {
              "type": "string",
              "minLength": 1
            },
            "heading": {
              "$ref": "#/definitions/displayHeading"
            },
            "cta": {
              "$ref": "#/definitions/cta"
            },
            "priceNote": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "line1",
                "line2"
              ],
              "properties": {
                "line1": {
                  "type": "string",
                  "minLength": 1
                },
                "line2": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "row": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "left",
                "right"
              ],
              "properties": {
                "left": {
                  "$ref": "#/definitions/textBlock"
                },
                "right": {
                  "$ref": "#/definitions/textBlock"
                }
              }
            },
            "timeline": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cornerLabel",
                "columns",
                "rows"
              ],
              "properties": {
                "cornerLabel": {
                  "type": "string",
                  "minLength": 1
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "title",
                      "date"
                    ],
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "date": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "price",
                      "markerColumn",
                      "bold"
                    ],
                    "properties": {
                      "price": {
                        "type": "string",
                        "minLength": 1
                      },
                      "markerColumn": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "bold": {
                        "type": "boolean"
                      }
                    }
                  },
                  "minItems": 1,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patterns",
            "reducedMotionFallback"
          ],
          "properties": {
            "patterns": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "enum": [
                  "scramble-text",
